# LLM API Key (Google Gemini) & Model Name
GEMINI_API_KEY=
GEMINI_MODEL=

# GitHub Personal Access Token (scopes: repo, workflow)
GITHUB_TOKEN=

# Render Platform API Key
RENDER_API_KEY=

# GitHub OAuth App Credentials (optional for local/test; required for GitHub OAuth)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Session Secret (for signed auth session cookies)
SESSION_SECRET=

# Server Configuration (optional)
PORT=
ENVIRONMENT=
DB_PATH=
GITLEAKS_PATH=
